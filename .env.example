# Скопируйте в .env и впишите ключ LLM. Остальные значения подходят для локального запуска.
# Copy to .env and fill in the LLM key. Other values are fine for a local run.

# --- LLM (любой OpenAI-совместимый адрес; смена не требует пересборки образов) ---
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=qwen/qwen3.8-27b
LLM_API_KEY=
# Дополнительные поля запроса (JSON): здесь выключается режим рассуждений Qwen.
# OpenRouter: рассуждения выключены и задан порядок провайдеров — одну и ту же модель разные
#   хосты отдают со скоростью от 11 до 200 токенов/с (замер в README); если первого нет,
#   OpenRouter берёт следующего.
# vLLM/SGLang в контуре заказчика: {"chat_template_kwargs":{"enable_thinking":false}}
LLM_EXTRA_BODY={"reasoning":{"enabled":false},"provider":{"order":["Cerebras","Parasail","Chutes"],"allow_fallbacks":true}}
# true — просить у сервера JSON-ответ (response_format), если он это поддерживает
LLM_JSON_MODE=false

# --- Публичный порт веб-интерфейса ---
WEB_PORT=8080
# true, если сервис открыт по HTTPS: cookie сессии будет только для HTTPS
COOKIE_SECURE=false
# true — включить Swagger UI на /api/docs (по умолчанию выключен: это карта всего API)
ENABLE_API_DOCS=false

# --- Внутренние сервисы (наружу не публикуются; в проде поменяйте пароли) ---
POSTGRES_USER=slides
POSTGRES_PASSWORD=slides-local-only
POSTGRES_DB=slides
REDIS_PASSWORD=redis-local-only

# --- Озвучка (ключ ElevenLabs каждый пользователь вводит сам в «Настройках») ---
# Ключ шифрования пользовательских ключей (Fernet; несколько через запятую — первый шифрует,
# остальные только расшифровывают, для ротации). Пусто — ключ создаётся сам на томе данных.
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_KEY=
# Модель ElevenLabs для голоса диктора
VOICE_MODEL=eleven_v4

# --- Приложение ---
LOG_LEVEL=INFO
