# Скопируйте в .env и впишите ключ LLM. Остальные значения подходят для локального запуска.
# Copy to .env and fill in the LLM key. Other values are fine for a local run.

# --- LLM (любой OpenAI-совместимый адрес; смена не требует пересборки образов) ---
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=qwen/qwen3.8-27b
LLM_API_KEY=
# Дополнительные поля запроса (JSON): здесь выключается режим рассуждений Qwen.
# OpenRouter: {"reasoning":{"enabled":false}}
# vLLM/SGLang в контуре заказчика: {"chat_template_kwargs":{"enable_thinking":false}}
LLM_EXTRA_BODY={"reasoning":{"enabled":false}}
# true — просить у сервера JSON-ответ (response_format), если он это поддерживает
LLM_JSON_MODE=false

# --- Публичный порт веб-интерфейса ---
WEB_PORT=8080

# --- Внутренние сервисы (наружу не публикуются; в проде поменяйте пароли) ---
POSTGRES_USER=slides
POSTGRES_PASSWORD=slides-local-only
POSTGRES_DB=slides
REDIS_PASSWORD=redis-local-only

# --- Приложение ---
LOG_LEVEL=INFO
