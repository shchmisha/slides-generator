# Скопируйте в .env и впишите ключ LLM. Остальные значения подходят для локального запуска.
# Copy to .env and fill in the LLM key. Other values are fine for a local run.

# --- LLM (любой OpenAI-совместимый адрес; смена не требует пересборки образов) ---
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=
LLM_API_KEY=

# --- Публичный порт веб-интерфейса ---
WEB_PORT=8080

# --- Внутренние сервисы (наружу не публикуются; в проде поменяйте пароли) ---
POSTGRES_USER=slides
POSTGRES_PASSWORD=slides-local-only
POSTGRES_DB=slides
REDIS_PASSWORD=redis-local-only

# --- Приложение ---
LOG_LEVEL=INFO
